{
  "name": "repolens",
  "version": "1.0.0",
  "description": "Interactive dependency map and health report for software projects in many languages. Runs entirely on your machine.",
  "license": "MIT",
  "author": "Tristan Declercq",
  "homepage": "https://github.com/TriSDec/RepoLens#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TriSDec/RepoLens.git"
  },
  "bugs": {
    "url": "https://github.com/TriSDec/RepoLens/issues"
  },
  "keywords": [
    "dependency-graph",
    "code-visualization",
    "circular-dependencies",
    "static-analysis",
    "secret-scanning",
    "architecture",
    "monorepo",
    "cli"
  ],
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "bin": {
    "repolens": "bin/repolens.mjs"
  },
  "scripts": {
    "dev": "npm run analyzer:build && next dev",
    "build": "npm run analyzer:build && next build --webpack",
    "start": "next start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "test": "node scripts/build-lib.mjs && node --test \"tests/*.test.mjs\"",
    "typecheck": "tsc --noEmit",
    "analyzer:build": "node scripts/build-analyzer.mjs",
    "cli:build": "node scripts/build-cli.mjs",
    "repolens": "node bin/repolens.mjs",
    "sample:build": "node scripts/build-lib.mjs && node scripts/build-sample.mjs",
    "prestart": "node scripts/ensure-worker.mjs",
    "notices": "node scripts/gen-notices.mjs"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "next": "16.4.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.0",
    "vite": "8.3.4"
  }
}
